{
  "name": "claude-code-request-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx src/main.ts",
    "watch": "tsx src/cli.ts",
    "watch:server": "tsx src/cli.ts server --inspect-body",
    "watch:run": "tsx src/cli.ts run",
    "start": "node dist/src/main.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.3.3",
    "http-mitm-proxy": "^1.1.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "@types/yargs": "^17.0.33",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  }
}
